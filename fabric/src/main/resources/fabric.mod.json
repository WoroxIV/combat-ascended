{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "provides": ["combat_reforged"],
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_authors}"],
  "contact": {
    "homepage": "${mod_display_url}",
    "issues": "${mod_issue_tracker_url}",
    "sources": "https://github.com/WoroxIV/combat-ascended"
  },
  "license": "${mod_license}",
  "icon": "assets/combat_ascended/icon.png",
  "environment": "*",
  "entrypoints": {
    "fabric-gametest": ["com.combatascended.gametest.CombatGameTests"],
    "main": ["com.combatascended.fabric.CombatAscendedFabric"],
    "client": ["com.combatascended.fabric.CombatAscendedFabricClient"],
    "modmenu": ["com.combatascended.fabric.ModMenuIntegration"],
    "jei_mod_plugin": ["com.combatascended.compat.jei.CombatAscendedJeiPlugin"],
    "emi": ["com.combatascended.compat.emi.CombatAscendedEmiPlugin"]
  },
  "mixins": [
    "combatascended.mixins.json",
    "combatascended.fabric.mixins.json"
  ],
  "accessWidener": "combat_ascended.accesswidener",
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=17",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*",
    "jei": "*",
    "emi": "*"
  }
}
